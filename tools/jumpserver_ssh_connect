#!/bin/bash

ScriptVersion="1.2"

CACHE_DIR="${HOME}/.cache/jumpserver"
CACHE_FILE="${CACHE_DIR}/mfa_code"
CACHE_TTL=60

save_mfa_cache() {
	local val="$1"
	local ts="${2:-$(date +%s)}"
	mkdir -p "$CACHE_DIR" 2>/dev/null
	(
		umask 077
		echo "$ts $val" >"$CACHE_FILE"
	) 2>/dev/null
	chmod 600 "$CACHE_FILE" 2>/dev/null || true
}

get_or_prompt_mfa_code() {
	local now
	now=$(date +%s)

	# 1. If code was already passed explicitly (via -c or positional args)
	if [ -n "$code" ]; then
		save_mfa_cache "$code" "$now"
		return 0
	fi

	# 2. Try reading from cache
	if [ -f "$CACHE_FILE" ]; then
		local cached_time cached_val
		read -r cached_time cached_val <"$CACHE_FILE" 2>/dev/null
		if [ -n "$cached_time" ] && [ -n "$cached_val" ] && [[ "$cached_time" =~ ^[0-9]+$ ]]; then
			if [ $((now - cached_time)) -ge 0 ] && [ $((now - cached_time)) -lt "$CACHE_TTL" ]; then
				code="$cached_val"
				return 0
			fi
		fi
	fi

	# 3. Cache missing or expired: prompt user in terminal
	while [ -z "$code" ]; do
		if ! read -r -p "请输入 MFA Code: " code; then
			echo "" >&2
			echo "Error: Failed to read MFA Code from input." >&2
			exit 1
		fi
		code=$(echo "$code" | tr -d '[:space:]')
	done

	save_mfa_cache "$code" "$now"
}

unset ip
unset code

usage() {
	cat <<EOF
Usage: $(basename "$0") [options] <ip> [otp_code]
   or: $(basename "$0") -i <ip> [-c <otp_code>]

Connect to target server through JumpServer.

Arguments:
  <ip>                        Target host IP address
  [otp_code]                  OTP dynamic verification code (cached for 60s)

Options:
  -i, --ip IP                 Target host IP address
  -c, -o, --code, --otp CODE  OTP dynamic verification code (updates cache)
  -h, --help                  Display this help message and exit
  -d, --debug                 Run script in debug mode (set -x)
  -v, --version               Display script version
EOF
}

main() {
	local ip="$1"
	local code="$2"
	local expect_file="/tmp/jumpserver_ssh_connect.expect"

	cat <<EOF >"$expect_file"
#!/usr/bin/expect

set ip   [lindex \$argv 0]
set code [lindex \$argv 1]

spawn ssh -p 2222 yangjing7@ops@\${ip}@jump.imgo.tv
expect {
	"Are you sure you want to continue connecting*"
	{send "yes\n";exp_continue}
	"password:"
	{send "Zxcvbnm75455..\n"}
}

expect {
	"OTP Code*"
	{send "\$code\n"}
}
interact
EOF

	expect "$expect_file" "$ip" "$code"
}

while getopts ":hdi:c:o:v-:" opt; do
	case "${opt}" in
	h) usage && exit 0 ;;
	d) set -x ;;
	v)
		echo "$0 -- Version $ScriptVersion"
		exit 0
		;;
	i) ip="${OPTARG}" ;;
	c | o) code="${OPTARG}" ;;
	-)
		case "${OPTARG}" in
		help) usage && exit 0 ;;
		debug) set -x ;;
		version)
			echo "$0 -- Version $ScriptVersion"
			exit 0
			;;
		ip=*) ip="${OPTARG#*=}" ;;
		ip)
			ip="${!OPTIND}"
			OPTIND=$((OPTIND + 1))
			;;
		code=* | otp=*) code="${OPTARG#*=}" ;;
		code | otp)
			code="${!OPTIND}"
			OPTIND=$((OPTIND + 1))
			;;
		*)
			echo "Invalid option: --${OPTARG}" >&2
			usage >&2
			exit 1
			;;
		esac
		;;
	:)
		echo "Option -${OPTARG} requires an argument." >&2
		usage >&2
		exit 1
		;;
	*)
		echo "Invalid option: -${OPTARG}" >&2
		usage >&2
		exit 1
		;;
	esac
done
shift $((OPTIND - 1))

# Fallback to positional arguments if not specified via options
if [ -z "$ip" ] && [ -n "$1" ]; then
	ip="$1"
	shift
fi

if [ -z "$code" ] && [ -n "$1" ]; then
	code="$1"
	shift
fi

# Validation: ensure target IP is provided
if [ -z "$ip" ]; then
	echo "Error: Target host IP address is required." >&2
	usage >&2
	exit 1
fi

if [ $# -gt 0 ]; then
	echo "Error: Too many arguments: $*" >&2
	usage >&2
	exit 1
fi

get_or_prompt_mfa_code

main "$ip" "$code"
