{
  "snippets.ultisnips.pythonPrompt": false,
  "coc.preferences.currentFunctionSymbolAutoUpdate": true,
  "clangd.arguments": [
    "--completion-style=detailed",
    "--header-insertion=iwyu",
    "--background-index",
    "--clang-tidy"
  ],
  "inlayHint.enable": false,
  "semanticTokens.enable": true,  // c/c++ 语法高亮（主要是宏定义的高亮）
  "python.pythonPath":"/usr/local/bin/python3.10",
  "languageserver": {
    "asm": {
      "command": "asm-lsp",
      "filetypes": ["nasm", "asm"],
      "rootPatterns": [".git"]
    }
  },
  "mcp": {
    "autoStart": true,
    "allowedTools": [
     "editor/state",
      "document/read",
      "document/list",
      "document/write",
      "workspace/apply_edit",
      "lsp/references",
      "lsp/definition",
      "lsp/declaration",
      "lsp/type_definition",
      "lsp/implementation",
      "lsp/document_symbols",
      "lsp/workspace_symbols",
      "lsp/diagnostics",
      "lsp/code_actions",
      "lsp/hover",
      "lsp/rename",
      "lsp/format"
    ]
  }
}
